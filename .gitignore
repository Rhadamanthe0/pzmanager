# Sensitive configuration (à la racine ; contient aussi la clé de service Google)
.env

# Operational logs
logs/

# Discord bot Python venv (local, volumineux)
data/scripts/discord/.venv/
data/scripts/discord/__pycache__/

# Backup directories (very large)
data/dataBackups/
data/fullBackups/

# Game server installation (36M+ files, binary)
data/pzserver/
Zomboid/

# Versionning des mods : le script et le mode opératoire sont versionnés ;
# les données propres à CE serveur (états de version, mods parqués) ne le sont pas.
versionning/V*.txt
versionning/Mods bugués*.csv

# Temporary files
temp/
# Sortie de session laissée à la racine par un `nohup` (agent, script lancé à la main)
nohup.out

# IDE configuration
.vscode/
.vs/
.claude/
CLAUDE.md

# OS files
.DS_Store
Thumbs.db

# Registre des dates de création des comptes : données joueurs (pseudos +
# SteamID), propres à une installation. Sauvegardé par fullBackup.sh, pas par git.
data/whitelistLedger.csv
