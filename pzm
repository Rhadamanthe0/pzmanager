#!/usr/bin/env bash
set -euo pipefail

# pzmanager - Interface principale
# Usage: pzm <commande> <sous-commande> [arguments]

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

show_help() {
    cat << 'EOF'
pzmanager - Project Zomboid Server Manager

Usage: pzm <commande> <sous-commande> [arguments]

Commandes disponibles:

  server <action> [délai] [options]
    start              Démarrer le serveur (sans compte à rebours)
    stop [délai]       Arrêter (30m|15m|5m|2m|30s|now|auto, défaut: auto)
    restart [délai]    Redémarrer
    status             Statut + logs récents
                       délai auto = 5m si >=2 joueurs, 2m si 1, now si 0
                       Comptage indisponible : 2m
    Options communes à start/stop/restart :
      --reason TEXT       Motif affiché AUX JOUEURS (en jeu) et sur Discord.
                          Sans motif : arrêt/restart indique seulement l'origine ;
                          start n'envoie pas d'annonce de démarrage.
      --silent            Aucune annonce Discord (redémarrage de debug)
      --automatic         Marque l'action comme déclenchée automatiquement
    Délai facultatif pour stop/restart ; si précisé, avant les options.
    Exemple sans délai : `server restart --reason "Ajout de mods"`.

  backup <action> [arguments]
    create [--consistent]  Snapshot ; --consistent exige un serveur déjà arrêté
                       À chaud : copie au mieux, cohérence applicative non garantie
    full               Backup complet avec sync
    restore <chemin>   Restaurer données Zomboid (dossier ; serveur arrêté)
    restore-character <pseudo> <backup> [--dry-run]
                       Restaurer un personnage (application : serveur arrêté)
                       --dry-run : aperçu ; sans option, écrase l’existant
    restore-zone <backup> <x1> <y1> <x2> <y2> [options]
                       Restaurer exactement les tuiles de carte depuis un snapshot ou ZIP
                       Coordonnées en TUILES, coins inclusifs ; toutes les hauteurs
                       Minimum : 1 tuile, sous-sols et étages compris
                       Une seule tuile : répéter ses coordonnées X Y X Y
      --dry-run           Aperçu sans modification (comportement par défaut)
      --apply             Appliquer la restauration (serveur arrêté requis)
      --save <monde>       Choisir le monde multijoueur
                       Écrase terrain, constructions et conteneurs sur toute
                       la hauteur des tuiles ; annulation auto si échec.
                       Tuiles voisines conservées ; JDK compatible requis pour appliquer
                       Aperçu : JDK requis si les dictionnaires diffèrent
                       Backup : nom de snapshot, dossier ou ZIP
                       Procédure et limites : docs/USAGE.md#restore-a-map-zone-build-42
    list               Lister backups disponibles
    resume-writing <copie>  Reprise explicite d'un nettoyage interrompu
    verify-recovery <id> --restored|--reverted
                       Vérifier les octets récupérés et clôturer le journal

  whitelist <action> [arguments]
    list               Liste blanche SteamID + comptes + bannis
    add <id64> [nom]   Autoriser un SteamID (Open=false ; serveur démarré requis)
    remove <id64> [--ban]  Retirer un SteamID (17 chiffres ; serveur démarré)
                       --ban = bannir définitivement ; pseudo refusé
    remove-account <nom|id64> [...] [--dry-run]  Supprimer des comptes (garde les
                       personnages ; retire les SteamID devenus orphelins ; serveur arrêté)
    rename-account <ancien> <nouveau> [--dry-run]
                       Renommer un compte (garde perso et mdp ; serveur arrêté)
                       --dry-run : aperçu possible serveur démarré pour ces deux actions
    resetpassword <nom>  Reset mot de passe (serveur arrêté requis)
    purge [durée]      Lister inactifs (3m, 60d... défaut: .env)
    purge [durée] --delete  Supprimer après confirmation en terminal (serveur arrêté)
    help               Aide détaillée de la liste blanche

  admin <action> [arguments]
    reset [options]    Wipe complet (backup → suppression → nouveau monde)
      --keep-config       Restaurer configs (<monde>.ini, SandboxVars, spawns)
      --keep-whitelist    Restaurer whitelist
    maintenance [délai] [options]   Maintenance complète
                       (30m|15m|5m|2m|30s|now|auto, défaut: 30m)
      --reason TEXT       Raison de la maintenance (ex: "Augmentation RAM")
      --no-reboot         Redémarrer le service, jamais la machine
      --silent            Masquer les annonces normales Discord
      --automatic         Marquer la maintenance comme automatique

  install <action>
    budget             Installer le plafond PZ partagé (services arrêtés)
    system             Configuration système initiale
    zomboid            Installer serveur Project Zomboid
    discord            Installer/activer le bot Discord (slash /pzm)

  map <action> [arguments]
    wipe <x> <y>                Regenerer le chunk d'une tuile
    wipe <x1> <y1> <x2> <y2>    Regenerer les chunks couvrant un rectangle
      --save <monde>       Choisir le monde multijoueur
      (serveur arrete ; suppression immediate + snapshot auto ;
       efface aussi le niveau cellule 256x256 -- toujours, sans option)

  rcon <cmd> [args] [--no-output]  Envoyer une commande console au serveur
                       --no-output : ne pas attendre la réponse

  mods check [fichier] Vérifier les mods requis par le monde (INI ou V[N].txt)

  discord <message>    Envoyer message sur Discord (webhook)
                       Bot de commandes /pzm : voir 'pzm install discord'

Exemples:
  pzm server start
  pzm server restart 5m --reason "Ajout de mods"
  pzm backup restore data/dataBackups/backup_2026-01-11_14h30m00s
  pzm backup restore-zone backup_2026-10-12_10h00m00s 10500 9500 10500 9500
    (aperçu de la seule tuile 10500,9500 sur toute sa hauteur ; --apply pour restaurer)
  pzm whitelist add "76561198012345678" "PlayerName"
  pzm admin reset --keep-config --keep-whitelist
  pzm rcon save
  pzm rcon servermsg "Message aux joueurs"
  pzm rcon setaccesslevel "Marc Rivière" admin

Documentation: docs/QUICKSTART.md
EOF
}

# Les huit routeurs ci-dessous répétaient mot pour mot le même bloc d'erreur.
# Le centraliser garantit qu'un ajout de sous-commande ne laisse pas une liste
# « Actions: » périmée dans un coin du fichier.
invalid_action() {
    local kind="$1" action="$2"; shift 2
    echo "Erreur: Action ${kind} invalide: ${action}"
    echo "Actions: $*"
    exit 1
}

usage_error() {
    echo "Erreur: $1"
    echo "Usage: $2"
    exit 1
}

# Routage commande server
cmd_server() {
    local action="${1:-}"
    shift || true

    case "$action" in
        start|stop|restart|status)
            exec "${SCRIPT_DIR}/data/scripts/core/pz.sh" "$action" "$@"
            ;;
        *)
            invalid_action "serveur" "$action" "start, stop, restart, status"
            ;;
    esac
}

# Routage commande backup
cmd_backup() {
    local action="${1:-}"
    shift || true

    case "$action" in
        create)
            exec "${SCRIPT_DIR}/data/scripts/backup/dataBackup.sh" "$@"
            ;;
        full)
            exec "${SCRIPT_DIR}/data/scripts/backup/fullBackup.sh"
            ;;
        restore)
            [[ $# -gt 0 ]] || usage_error "Chemin backup requis" "pzm backup restore <chemin>"
            exec "${SCRIPT_DIR}/data/scripts/backup/restoreZomboidData.sh" "$@"
            ;;
        restore-zone)
            exec "${SCRIPT_DIR}/data/scripts/backup/restoreZone.sh" "$@"
            ;;
        resume-writing)
            exec "${SCRIPT_DIR}/data/scripts/backup/resumeWritingCleanup.sh" "$@"
            ;;
        verify-recovery)
            exec "${SCRIPT_DIR}/data/scripts/backup/verifyWorldRecovery.sh" "$@"
            ;;
        restore-character)
            [[ $# -ge 2 ]] || usage_error "pseudo et backup requis" "pzm backup restore-character <pseudo> <backup>"
            exec "${SCRIPT_DIR}/data/scripts/backup/restoreCharacter.sh" "$@"
            ;;
        list)
            exec "${SCRIPT_DIR}/data/scripts/backup/listBackups.sh"
            ;;
        *)
            invalid_action "backup" "$action" "create, full, restore, restore-character, restore-zone, list, resume-writing, verify-recovery"
            ;;
    esac
}

# Routage commande whitelist
cmd_whitelist() {
    local action="${1:-}"
    shift || true

    case "$action" in
        list|add|remove|remove-account|rename-account|resetpassword|purge|help)
            exec "${SCRIPT_DIR}/data/scripts/admin/manageWhitelist.sh" "$action" "$@"
            ;;
        *)
            invalid_action "whitelist" "$action" "list, add, remove, remove-account, rename-account, resetpassword, purge, help"
            ;;
    esac
}

# Routage commande admin
cmd_admin() {
    local action="${1:-}"
    shift || true

    case "$action" in
        reset)
            exec "${SCRIPT_DIR}/data/scripts/admin/resetServer.sh" "$@"
            ;;
        maintenance)
            exec "${SCRIPT_DIR}/data/scripts/admin/performFullMaintenance.sh" "$@"
            ;;
        *)
            invalid_action "admin" "$action" "reset, maintenance"
            ;;
    esac
}

# Routage commande install
cmd_install() {
    local action="${1:-}"
    shift || true

    case "$action" in
        budget)
            exec "${SCRIPT_DIR}/data/scripts/install/setupSharedBudget.sh"
            ;;
        system|zomboid)
            local helper="/usr/local/libexec/pzmanager/install/setupSystem.sh"
            [[ "$action" == system ]] || helper="/usr/local/libexec/pzmanager/install/configurationInitiale.sh"
            [[ -f "$helper" && -x "$helper" ]] || {
                echo "Helper privilégié absent : $helper ; réinstaller les helpers root de PZManager." >&2
                return 1
            }
            if [[ "$action" == system ]]; then
                exec sudo "$helper" --manager-root "$SCRIPT_DIR"
            fi
            exec sudo "$helper" --manager-root "$SCRIPT_DIR" zomboid "$@"
            ;;
        discord)
            exec "${SCRIPT_DIR}/data/scripts/install/setupDiscordBot.sh"
            ;;
        *)
            invalid_action "install" "$action" "system, zomboid, discord, budget"
            ;;
    esac
}

# Routage commande map
cmd_map() {
    local action="${1:-}"
    shift || true

    case "$action" in
        wipe)
            exec "${SCRIPT_DIR}/data/scripts/admin/wipeMapTile.sh" "$@"
            ;;
        *)
            invalid_action "map" "$action" "wipe"
            ;;
    esac
}

# Routage commande rcon
cmd_rcon() {
    [[ $# -gt 0 ]] || usage_error "Commande RCON requise" "pzm rcon <commande>"
    exec "${SCRIPT_DIR}/data/scripts/internal/sendCommand.sh" "$@"
}

# Routage commande discord
cmd_discord() {
    [[ $# -gt 0 ]] || usage_error "Message requis" "pzm discord <message>"
    exec "${SCRIPT_DIR}/data/scripts/internal/sendDiscord.sh" "$*"
}

# Point d'entrée principal
cmd_mods() {
    [[ "${1:-}" == check ]] || usage_error "Action mods invalide" "pzm mods check [fichier]"
    shift
    exec "${SCRIPT_DIR}/data/scripts/internal/checkWorldMods.sh" "$@"
}

main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    local command="$1"
    shift

    case "$command" in
        server|backup|whitelist|admin|install|map|rcon|discord|mods)
            "cmd_${command}" "$@"
            ;;
        help|--help|-h)
            show_help
            exit 0
            ;;
        *)
            echo "Erreur: Commande inconnue: $command"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

# Aide/status et installation de ressources sont des entrées de contrôle.
# Bootstrap serveur sans unité existante : l'installateur prépare la slice
# avant ses helpers utilisateur. Une réinstallation courante reste confinée.
if [[ "${1:-}" == server && "${2:-}" == status ]]; then
    main "$@"
    exit
fi
case "${1:-help}:${2:-}" in
    help:*|--help:*|-h:*|install:system|install:budget) ;;
    install:zomboid)
        if [[ -e "${HOME}/.config/systemd/user/zomboid.service" ]]; then
            if ! python3 "${SCRIPT_DIR}/data/scripts/lib/shared_memory_budget.py" inside; then
                exec bash "${SCRIPT_DIR}/data/scripts/lib/run_in_pz_slice.sh" /bin/bash "$0" "$@"
            fi
            python3 "${SCRIPT_DIR}/data/scripts/lib/shared_memory_budget.py" check
        fi
        ;;
    install:discord)
        # Son bootstrap prépare seulement pz.slice puis se réexécute dedans
        # avant le venv/pip. Pas d'exemption des opérations du bot.
        ;;
    *)
        if ! python3 "${SCRIPT_DIR}/data/scripts/lib/shared_memory_budget.py" inside; then
            exec bash "${SCRIPT_DIR}/data/scripts/lib/run_in_pz_slice.sh" /bin/bash "$0" "$@"
        fi
        python3 "${SCRIPT_DIR}/data/scripts/lib/shared_memory_budget.py" check
        ;;
esac
main "$@"
