[Unit]
Description=Project Zomboid - Surveillance RAM totale et heap (redémarrage adaptatif)

[Service]
Slice=pz.slice
ExecStartPre=/usr/bin/python3 %h/pzmanager/data/scripts/lib/shared_memory_budget.py check
Type=oneshot
# Plafond global fini : préavis jusqu'à 30m, puis arrêt/sauvegarde/démarrage.
# L'appel direct au backup partage ce budget, sans borne d'I/O individuelle.
TimeoutStartSec=7200
ExecStart=%h/pzmanager/data/scripts/internal/checkHeapAndRestart.sh
StandardOutput=journal
StandardError=journal
