[Unit]
Description=Project Zomboid - Hourly Data Backup
After=zomboid.service

[Service]
Type=oneshot
# Le prune (unlink de snapshots hardlinkés) reste coûteux. Il est plafonné
# par run (BACKUP_PRUNE_MAX_DELETE) pour tenir dans ce
# timeout ; 2400s = marge confortable pour save+rsync+un lot de suppressions, sans
# jamais tuer un run (ce qui le marquerait failed et laisserait un prune partiel).
# C'est un plafond CHOISI : un Type=oneshot n'a pas de timeout par défaut. La
# valeur a été montée de 600 à 2400 le 25/07/2026, après des runs tués en plein
# prune qui spammaient une alerte Discord « failed » toutes les heures.
TimeoutStartSec=2400
ExecStart=%h/pzmanager/data/scripts/backup/dataBackup.sh
StandardOutput=journal
StandardError=journal
# Le parcours du monde et la création des hardlinks sont coûteux en CPU.
# Nice=19 et CPUWeight=10 gardent le jeu prioritaire (zomboid.service = 1000).
# CPUQuota=25% borne le lanceur à un quart de cœur. dataBackup.sh impose
# 25% à la copie quand le jeu tourne, 300% si son absence est prouvée.
# L'ancien plafond
# de 20% imposait ~15 min de copie pour ~3 min de CPU. Le NVMe en scheduler
# "none" et le contrôleur io non délégué ne permettent pas de compter sur
# ionice/IOWeight pour limiter les I/O : surveiller leur pression après réglage.
Nice=19
CPUWeight=10
CPUQuota=25%
