[Unit]
Description=Project Zomboid - Discord Bot (pzm)
After=network-online.target
Wants=network-online.target

[Service]
Slice=pz.slice
ExecStartPre=/usr/bin/python3 %h/pzmanager/data/scripts/lib/shared_memory_budget.py check
Type=simple
WorkingDirectory=%h/pzmanager
ExecStart=%h/pzmanager/data/scripts/discord/run-bot.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
