[Unit]
Description=Project Zomboid - Daily Maintenance

[Service]
Slice=pz.slice
ExecStartPre=/usr/bin/python3 %h/pzmanager/data/scripts/lib/shared_memory_budget.py check
Type=oneshot
ExecStart=%h/pzmanager/data/scripts/admin/performFullMaintenance.sh --silent --automatic --reason "Maintenance quotidienne"
StandardOutput=journal
StandardError=journal
