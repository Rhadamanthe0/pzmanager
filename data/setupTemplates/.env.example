#!/bin/bash
# ------------------------------------------------------------------------------
# .env.example - Centralized configuration template for all scripts
# ------------------------------------------------------------------------------
# Usage: This file will be automatically copied to .env on first script run
#
# This file contains all environment variables shared by the Project Zomboid
# server management scripts.
# ------------------------------------------------------------------------------

# === Users and base paths ===
export PZ_USER="pzuser"
export PZ_HOME="/home/${PZ_USER}"
export PZ_MANAGER_DIR="${PZ_HOME}/pzmanager"
export PZ_DATA_DIR="${PZ_MANAGER_DIR}/data"
# Les scripts vivent sous data/ ; ce fichier .env et les logs, eux, sont à la
# racine de pzmanager/ (config et sorties d'exécution séparées du code).
export PZ_SCRIPTS_DIR="${PZ_DATA_DIR}/scripts"

# === Project Zomboid server ===
export PZ_INSTALL_DIR="${PZ_DATA_DIR}/pzserver"
export PZ_CONTROL_PIPE="${PZ_INSTALL_DIR}/zomboid.control"
export PZ_SERVICE_NAME="zomboid.service"
export PZ_SOURCE_DIR="${PZ_MANAGER_DIR}/Zomboid"

# Nom du monde. PZ en dérive TOUS les fichiers de la partie : db/<nom>.db,
# Server/<nom>.ini, Server/<nom>_SandboxVars.lua, _spawnpoints, _spawnregions.
# "servertest" est le défaut du jeu ; zomboid.service le passe explicitement via
# -servername pour que le nom du monde et les chemins lus par les scripts ne
# puissent pas diverger.
#
# ATTENTION : le changer sur un serveur existant = NOUVEAU MONDE VIERGE. PZ crée
# la partie <nouveau nom> à côté ; l'ancienne reste sur le disque sous son nom,
# intacte mais ignorée (whitelist et personnages compris). Pour renommer un monde
# existant, renommer d'abord les fichiers, serveur arrêté.
export PZ_SERVER_NAME="servertest"

# Chemins dérivés du monde. Définis ici une seule fois : les scripts les lisent
# au lieu de recomposer "servertest" chacun de leur côté.
export PZ_DB_PATH="${PZ_SOURCE_DIR}/db/${PZ_SERVER_NAME}.db"
export PZ_INI_PATH="${PZ_SOURCE_DIR}/Server/${PZ_SERVER_NAME}.ini"

# === Network ports ===
# Ports du serveur PZ (à changer si plusieurs serveurs sur la même machine).
# Ce sont les SEULS ports que PZ B42 écoute, vérifié en production (ss -lnup sur
# le pid de la JVM) : setupSystem.sh n'ouvre donc que ces deux-là.
# Les anciens PZ_PORT_RCON (27015) et PZ_PORT_STEAM (8766) ont été retirés : plus
# aucun script ne les lisait, RCONPassword est vide (le pilotage passe par la FIFO
# zomboid.control) et la découverte Steam se fait via le port de jeu en B42. Les
# ouvrir n'exposait que de la surface d'attaque pour des services inexistants.
export PZ_PORT_GAME=16261
export PZ_PORT_GAME2=16262

# === SteamCMD ===
export STEAMCMD_PATH="/usr/games/steamcmd"
export STEAM_APP_ID="380870"
# Branche Steam du serveur dédié. VIDE = branche publique (stable), ce qui est le
# choix par défaut. Ne renseigner un nom (ex: "unstable") que pour suivre
# volontairement une beta : le gabarit livrait "unstable", si bien qu'une
# installation neuve démarrait sur la branche instable sans l'avoir demandé.
export STEAM_BETA_BRANCH=""
# Compte Steam pour les téléchargements steamcmd (app_update serveur + mods Workshop).
# Laisser VIDE => "anonymous". Depuis 2026 Steam a retiré Project Zomboid des
# téléchargements Workshop anonymes : un mod NEUF ou MIS À JOUR ne se télécharge
# plus en anonyme et fait crasher le serveur au boot. Renseigner ici un compte
# Steam DÉDIÉ possédant PZ (jamais un compte personnel : steamcmd stocke sur le
# disque un jeton de login + statut "machine de confiance" réutilisable). Se
# connecter une fois manuellement (`steamcmd +login <compte>`) pour mettre le
# jeton en cache (Steam Guard validé une seule fois), puis renseigner le nom ici.
export STEAM_LOGIN=""

# === Java JRE ===
export JAVA_VERSION="25"
export JAVA_PACKAGE="openjdk-${JAVA_VERSION}-jre-headless"
export JAVA_PATH="/usr/lib/jvm/java-${JAVA_VERSION}-openjdk-amd64"
# Source des paquets JDK : "debian" (depots de la distribution, defaut sur) ou
# "temurin" (Adoptium Temurin, paquet temurin-<v>-jre — son depot APT doit etre
# configure sur la machine au prealable). Si la version demandee n'a aucun
# candidat apt sur l'OS (ex: 25 sur Debian 12), l'installateur replie vers 21
# puis 17 en le journalisant — voir la matrice OS/JDK dans
# docs/WHAT_IS_INSTALLED.md.
export PZ_JDK_SOURCE="debian"

# JVM alternative pour LE SERVEUR PZ (pas les outils) : si défini et valide, le
# serveur tourne sur cette JVM au lieu du jre64 bundlé (Zulu). Prévu pour Oracle
# GraalVM (compilo Graal JIT actif) -> optimise les boucles d'allocation intensives
# de la génération de chunks (gels mono-thread). linkJvm.sh remplace jre64 par un
# lien vers ce dossier à chaque démarrage (validate le restaure sinon). Vider cette
# variable = revenir au jre64 bundlé au prochain redémarrage. Doit contenir bin/java.
export PZ_GRAALVM_HOME=""

# === Backups ===
export BACKUP_DIR="${PZ_DATA_DIR}/dataBackups"
export BACKUP_LATEST_LINK="${BACKUP_DIR}/latest"

# Rétention grand-père/père/fils (GFS) des snapshots hardlinkés locaux
# (dataBackup.sh). A remplacé l'ancienne rotation plate BACKUP_RETENTION_DAYS,
# qui n'est plus lue par aucun script et a donc été retirée d'ici :
#   - granularité horaire sur les dernières N heures,
#   - puis 1 par 6 h jusqu'à N jours,
#   - puis 1 par jour jusqu'à N jours.
export BACKUP_GFS_HOURLY_HOURS=12
export BACKUP_GFS_SIXHOURLY_DAYS=3
export BACKUP_GFS_DAILY_DAYS=14
# Optional logical CPUs for backups while the game runs (check host SMT topology).
# Empty = no affinity restriction. Stopped-server backups use all available CPUs.
export BACKUP_CPU_LIST=""
# Suppressions max par run (0 = illimité). Borne le coût d'un run quand un gros
# backlog doit être élagué (unlink de snapshots hardlinkés, coûteux en métadonnées) :
# le backlog s'écoule proprement sur plusieurs runs horaires sans dépasser le timeout.
export BACKUP_PRUNE_MAX_DELETE=15
# Budget de purge (secondes, 0 = illimité). Une suppression commencée finit,
# puis le surplus attend le passage suivant ; évite un timeout sur gros backlog.
export BACKUP_PRUNE_MAX_SECONDS=600

# Préavis joueurs avant le `save` du backup horaire. Ce save fige la boucle
# principale (~0,7 s mesuré) et PZ met alors les clients en pause : le gel est
# inévitable (seuil de 600 ms codé en dur dans ServerMap.checkClientPause), donc
# on l'annonce. 0 = pas de préavis (et pas d'attente).
export BACKUP_WARN_DELAY=10
# Aperçu de la rétention GFS sans rien supprimer (1 = simulation). Utile pour
# vérifier ce qu'un prune ferait sur un serveur vivant.
export BACKUP_PRUNE_DRY_RUN=0

# === External synchronization ===
export SYNC_BACKUPS_DIR="${PZ_DATA_DIR}/fullBackups"
# Nombre de ZIP off-site conservés (rétention par COMPTE, pas par jours) —
# mirrorés par Syncthing vers le PC fixe. fullBackup.sh en garde les N plus récents.
export OFFSITE_BACKUP_COUNT=7

# === Logs ===
export LOG_BASE_DIR="${PZ_MANAGER_DIR}/logs"
export LOG_ZOMBOID_DIR="${LOG_BASE_DIR}/zomboid"
export LOG_MAINTENANCE_DIR="${LOG_BASE_DIR}/maintenance"
export LOG_RETENTION_DAYS=30

# === Whitelist ===
# Seuil d'inactivité (jours) pour la purge auto des accès (whitelist + SteamID).
export WHITELIST_PURGE_DAYS=90

# === Maintenance ===
export REBOOT_ON_MAINTENANCE=true   # Redémarrer la machine après maintenance (false = restart service uniquement)

# === Stabilité mémoire (redémarrage adaptatif) ===
# Budget COMMUN pz.slice : 20 Gio pour jeu, bot, backups et gestion PZ.
# Préavis à 18 Gio de RSS agrégé : les caches récupérables ne déclenchent
# pas de restart, mais comptent dans MemoryCurrent et le plafond strict.
# Heap16 maximum : les 4 Gio restants sont une marge commune (pas une
# réservation) pour mémoire native, bot et tâches de fond. Leurs pics
# peuvent épuiser cette marge ; le kernel peut alors tuer un processus PZ.
# SSH et les autres services du compte sont hors de pz.slice.
export HEAP_RESTART_PERCENT=95        # seuil post-GC majeur (%)
export PZ_RAM_RESTART_GB=18           # seuil de RSS PZ agrégé (Gio ; entier 1..19)
export HEAP_RESTART_DELAY="5m"        # préavis joueurs avant restart (30m|15m|5m|2m|30s|now)

# === Détection de gel du thread principal (pz-stallwatch) ===
# Le serveur peut rester "actif" pour systemd alors que sa boucle principale est
# bloquée (joueurs figés, un cœur à 100 %). watchServerStall.sh le détecte via
# l'exporteur Prometheus, capture un thread dump et redémarre.
export STALL_AUTO_RESTART=1           # 0 = capturer le dump mais laisser l'admin redémarrer
export STALL_WATCH_SAMPLES=1          # relevés figés consécutifs avant capture
export STALL_BURN_MIN_PCT=60          # % CPU brûlé par "main" au-delà duquel le gel est confirmé

# Vivacité de la console. pz-modcheck écrit une commande dans le FIFO toutes les
# 5 min et attend la réponse : c'est une sonde gratuite. Une console qui ne lit
# plus le tube rend l'arrêt propre IMPOSSIBLE (le `quit` n'est jamais consommé,
# systemd SIGKILL au bout de 120 s, sans sauvegarde finale). On alerte après ce
# nombre de passages muets consécutifs — 3 = ~15 min, assez pour ne pas crier
# pendant le démarrage, qui est légitimement muet une minute ou deux.
export CONSOLE_SILENT_ALERT_AFTER=3

# === Divers ===
# Délai max d'écriture dans la FIFO de contrôle : écrire dans un pipe que plus
# personne ne lit (serveur figé/tué) bloquerait indéfiniment sans cette borne.
export PZ_PIPE_WRITE_TIMEOUT=10
# Espacement des vérifications de MAJ du build serveur (secondes). La détection
# des MODS reste, elle, à chaque passage du timer (toutes les 5 min) : elle est
# gratuite, alors qu'une requête de build lance un steamcmd complet.
export SERVER_UPDATE_CHECK_INTERVAL=3600

# Exporteur de métriques réseau interne de PZ (client Prometheus embarqué).
# Si défini, configureJvm.sh pose -DprometheusEnabled=true -DprometheusPort=<ce port>
# et le serveur expose http://127.0.0.1:<port>/metrics : serverPacketSend/Receive
# (histogrammes _count = paquets, _sum = octets, PAR type de paquet) = source EXACTE
# des paquets/s du serveur de jeu, scrappée par le bot pour le monitoring. Nécessite
# MultiplayerStatisticsPeriod>0 dans servertest.ini + un redémarrage. Vide = désactivé.
# SÉCURITÉ : l'exporteur binde 0.0.0.0 et expose des données sensibles (positions
# joueurs). setupSystem.sh restreint ce port à localhost via UFW (deny entrant + la
# loopback reste ouverte) ; ne PAS le rediriger sur le routeur. Vide = désactivé.
# Redémarrage serveur requis pour l'appliquer.
export PZ_PROMETHEUS_PORT=9110

# Override du heap max Java (Xmx), en Gio : entier 2..16. Vide = moitié de la RAM
# arrondie au Gio supérieur, plafonnée à 16. MemoryMax20G réserve ainsi 4 Gio
# pour toutes les charges hors heap, sans garantir une sauvegarde avant OOM.
# Les pages ZGC engagées comptent en shmem ; RSS moins heap utilisé n'est pas
# une mesure de mémoire native. configureJvm.sh refuse les anciens overrides de 20 Gio
# avant modification du JSON. Appliquer seulement pendant un arrêt convenu.
#export PZ_XMX_GB=16  # override 2..16 ; défaut moitié RAM arrondie, plafonné à 16 Gio

# ProjectWriting : conserve les textes et nettoie dessins et symboles
# dans les sauvegardes avant chaque démarrage, sans purge en session.
# 0 désactive ce garde ; les dessins déjà supprimés ne sont pas restaurés.
export PZ_WRITING_TEXT_ONLY=1

# === Discord (Optional) ===
# To enable Discord notifications, create a webhook in your Discord server:
# Server Settings → Integrations → Webhooks → New Webhook
# Then paste the webhook URL below (remove the # to uncomment)
export DISCORD_WEBHOOK=""
# Webhook SÉPARÉ pour le détail technique réservé à l'admin (chemin d'un thread
# dump après un gel, par exemple). Vide = ce détail reste dans le journal et n'est
# jamais posté sur le canal public des annonces joueurs.
export DISCORD_ADMIN_WEBHOOK=""

# === Discord Bot (Optional) ===
# Bot qui exécute les commandes pzm depuis Discord (slash command /pzm).
# 1. Créer une application + bot sur https://discord.com/developers/applications
#    (onglet Bot → Reset Token pour obtenir le token).
# 2. Inviter le bot avec les scopes OAuth2 "bot" + "applications.commands".
# 3. Activer le mode développeur Discord (Paramètres → Avancés) puis clic droit
#    pour "Copier l'identifiant" du serveur / salon / rôle.
# Installer/activer ensuite : pzm install discord
export DISCORD_BOT_TOKEN=""            # Token du bot (secret)
export DISCORD_BOT_GUILD_ID=""         # ID du serveur Discord (sync instantané des commandes)
export DISCORD_BOT_CHANNEL_ID=""       # ID du/des salon(s) autorisé(s) (séparés par des virgules)
export DISCORD_BOT_ADMIN_ROLE_ID=""    # ID(s) du/des rôle(s) autorisé(s) (séparés par virgule)
export DISCORD_BOT_CMD_TIMEOUT=2400    # Timeout d'exécution d'une commande (secondes)
# Salon où le bot notifie CHAQUE mort de joueur (pseudo, coordonnées, PvP/Non-PvP,
# heure ; la cause n'est pas journalisée par le serveur vanilla). Vide = désactivé.

# Salon de MONITORING : le bot y poste, toutes les MONITORING_INTERVAL secondes,
# un embed de santé (uptime, heap Java, RSS/natif, RAM système, températures,
# CPU, disque, GC, alertes pré-crash). Un message par cycle = « boîte noire »
# pour diagnostiquer un crash a posteriori. Le bot a besoin de View Channel +
# Send Messages + Embed Links dans ce salon. Vide = désactivé.
export DISCORD_BOT_MONITORING_CHANNEL_ID="" # ID du salon de monitoring
export DISCORD_BOT_MONITORING_INTERVAL=60   # Intervalle du monitoring (secondes, min 15)
# En plus de Discord, chaque cycle est journalisé dans logs/zomboid/monitoring.csv
# (une ligne/cycle : joueurs/max, paquets/s vs MaxPacketsPerSecond, heap, RAM, CPU, temp,
# disque…) pour relire les perfs hors Discord. Purge auto au-delà de N jours :
export DISCORD_BOT_MONITORING_CSV_DAYS=7    # Rétention du journal CSV (jours)

# === Google Sheets — "Versionning des mods" (optionnel) ===
# Utilisé par versionning/sheetVersionning.sh pour tenir à jour le classeur de
# suivi des versions de la liste de mods. Laisser vide = fonctionnalité inactive.
#
# La clé du compte de service est stockée ICI, en base64, et non dans un fichier
# .json à part : le JSON brut contient guillemets et retours ligne, donc
# inintégrable tel quel dans un `export VAR="..."`, et un secret de moins traîne
# sur le disque. Le script la décode à la volée dans un fichier temporaire
# chmod 600 qu'il supprime aussitôt.
#
# Pour la générer :
#   1. Google Cloud Console → IAM → Comptes de service → Créer → Clé JSON.
#   2. Partager le classeur avec l'adresse `client_email` du compte de service.
#   3. base64 -w0 cle.json     puis coller le résultat ci-dessous.
export GOOGLE_SERVICE_ACCOUNT_JSON_B64=""
# ID du classeur (le segment entre /d/ et /edit dans son URL).
export SHEET_VERSIONNING_ID=""
