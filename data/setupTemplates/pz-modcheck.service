[Unit]
Description=Project Zomboid - Check for Mod & Server Updates
After=zomboid.service

[Service]
Slice=pz.slice
ExecStartPre=/usr/bin/python3 %h/pzmanager/data/scripts/lib/shared_memory_budget.py check
Type=oneshot
RuntimeDirectory=pzmanager
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=%h/pzmanager/data/scripts/admin/triggerMaintenanceOnModUpdate.sh
StandardOutput=journal
StandardError=journal
