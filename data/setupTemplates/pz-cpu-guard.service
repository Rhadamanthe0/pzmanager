[Unit]
# Unité SYSTÈME (pas --user) : écrire dans /sys/devices/system/cpu demande root.
Description=Plafond de fréquence CPU asservi à la température (Ryzen 7 8745HS)
Documentation=file:/home/pzuser42/pzmanager/docs/HOST_ENVIRONMENT.md
After=multi-user.target

[Service]
Type=simple

# --- Réglages matériels appliqués une fois au démarrage -----------------------
# 1. Boost ON : rend accessible la plage 3801 -> 4966 MHz. Sans lui, le CPU est
#    bloqué à sa fréquence de base et ne peut pas répondre à une pointe de charge.
#    Le plafond ci-dessous (posé par le script) évite le régime ~88 °C mesuré
#    quand le boost tourne sans limite.
# 2. EPP balance_performance : c'est LE réglage qui fait redescendre les cœurs au
#    repos. Avec EPP=performance, le matériel restait biaisé vers le haut et
#    consommait pour rien. balance_performance garde une montée en charge franche.
#    Le gouverneur reste `powersave` : avec amd-pstate-epp en mode `active`, c'est
#    le mode normal — `performance` épinglerait la fréquence maximale en permanence.
ExecStartPre=/bin/sh -c 'echo 1 > /sys/devices/system/cpu/cpufreq/boost'
ExecStartPre=/bin/sh -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do echo balance_performance > "$f"; done'

Environment=CPU_GUARD_LADDER=4400000 4100000 3801000
Environment=CPU_GUARD_TEMP_HIGH=82
Environment=CPU_GUARD_TEMP_LOW=68
Environment=CPU_GUARD_INTERVAL=10
Environment=CPU_GUARD_DOWN_SAMPLES=2
Environment=CPU_GUARD_UP_SAMPLES=30
Environment=CPU_GUARD_DWELL=120

ExecStart=/home/pzuser42/pzmanager/data/scripts/internal/cpuThermalGuard.sh

# À l'arrêt, on repose le plafond le plus bas (= comportement d'avant, fréquence
# de base) plutôt que de laisser le CPU sans surveillance à 4,4 GHz.
ExecStopPost=/bin/sh -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do echo 3801000 > "$f"; done'
ExecStopPost=/bin/sh -c 'echo 0 > /sys/devices/system/cpu/cpufreq/boost'

Restart=on-failure
RestartSec=30
Nice=19

[Install]
WantedBy=multi-user.target
